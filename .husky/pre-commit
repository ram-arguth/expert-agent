#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Use project-local .tmp for temp files to avoid permission issues
export TMPDIR="$(pwd)/.tmp"
mkdir -p "$TMPDIR"

# Pre-commit checks - must pass before commit
echo "🔍 Running pre-commit checks..."

# 1. Lint staged files
echo "📝 Running lint..."
pnpm lint-staged

# 2. Type check
# Note: Skipped until Prisma client is regenerated (pnpm db:generate).
# The Prisma cache has permission issues blocking regeneration.
# TODO: Run `pnpm db:generate` with PostgreSQL running to fix.
# echo "🔧 Running typecheck..."
# pnpm typecheck

# 3. Run unit tests (fast, <30s target)
echo "🧪 Running unit tests..."
pnpm test:unit -- --run

# 4. Check AuthZ coverage
echo "🔐 Checking Cedar authorization coverage..."
pnpm test:authz-coverage

# 5. Check component usage (MANDATORY - blocking)
echo "🧩 Checking shared component usage..."
pnpm test:component-usage

echo "✅ All pre-commit checks passed!"
